[
  {"id":"SECRET-GITHUB","severity":"CRITICAL","message":"Potential embedded GitHub token; revoke and rotate if real","pattern":"\\b(?:gh[pousr]_[A-Za-z0-9]{36,255}|github_pat_[A-Za-z0-9_]{40,255})\\b"},
  {"id":"SECRET-AWS","severity":"HIGH","message":"Potential AWS access key ID; inspect associated credentials","pattern":"\\b(?:AKIA|ASIA)[A-Z0-9]{16}\\b"},
  {"id":"SECRET-AI-API","severity":"CRITICAL","message":"Potential embedded AI provider API key","pattern":"\\bsk-(?:(?:proj|svcacct|ant-api[0-9]+)-)?[A-Za-z0-9_-]{20,255}\\b"},
  {"id":"SECRET-SLACK","severity":"CRITICAL","message":"Potential embedded Slack token","pattern":"\\bxox[baprs]-[A-Za-z0-9-]{20,255}\\b"},
  {"id":"SECRET-NPM","severity":"CRITICAL","message":"Potential embedded npm access token","pattern":"\\bnpm_[A-Za-z0-9]{36,255}\\b"},
  {"id":"SECRET-GOOGLE","severity":"HIGH","message":"Potential embedded Google API key; review restrictions","pattern":"\\bAIza[A-Za-z0-9_-]{35}\\b"},
  {"id":"SECRET-JWT","severity":"HIGH","message":"JWT-like value; may contain sensitive claims or grant access","pattern":"\\beyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\b"},
  {"id":"SECRET-PRIVATE-KEY","severity":"CRITICAL","message":"Private-key block detected; rotate the key if real","pattern":"-----BEGIN (?:RSA |EC |DSA |OPENSSH |ENCRYPTED )?PRIVATE KEY-----"},
  {"id":"SECRET-ASSIGNMENT","severity":"HIGH","message":"Potential hard-coded credential assignment; review and rotate if real","pattern":"(?i)\\b(?:[A-Z_]*(?:api_?key|access_?key|token|password|passwd|pwd|secret|connection_?string|accountkey|sig)[A-Z_]*)[\"']?\\s*[:=]\\s*(?-i:(?![A-Z][a-z]+-[A-Z][A-Za-z0-9]*(?![A-Za-z0-9/+_=.!@#%^-])))[\"']?(?!(?:\\$|\\{|<|your[_ -]|example|placeholder|changeme|redacted|dummy|test[_-]|none\\b|null\\b|true\\b|false\\b))[A-Za-z0-9/+_=.!@#%^-]{8,}"},
  {"id":"SECRET-URL","severity":"HIGH","message":"Potential credentials embedded in a service URL","pattern":"(?i)\\b(?:https?|postgres(?:ql)?|mysql|mongodb(?:\\+srv)?|redis|amqps?)://[^\\s/:@]+:[^\\s/@]+@"},
  {"id":"SECRET-AUTH-VALUE","severity":"HIGH","message":"Potential literal authentication header value","pattern":"(?i)\\bauthorization[\"']?\\s*[:=]\\s*[\"']?(?:bearer|basic|token)\\s+(?!(?:your[_ -]|example|placeholder|redacted))[A-Za-z0-9_+/=.-]{8,}"}
]
