{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SkillVenom use case",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "summary", "category", "platforms", "severity", "status", "source", "artifacts", "expected", "why_it_works", "mitigations"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Z]{2}-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 4},
    "summary": {"type": "string", "minLength": 10},
    "category": {"type": "string"},
    "platforms": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "severity": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]},
    "status": {"enum": ["active", "regression", "benign-control"]},
    "source": {"type": "string"},
    "artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "scan_as"],
        "properties": {
          "path": {"type": "string"},
          "scan_as": {"type": "string"},
          "note": {"type": "string"}
        }
      }
    },
    "expected": {
      "type": "object", "additionalProperties": false,
      "required": ["rules"],
      "properties": {"rules": {"type": "array", "items": {"type": "string"}, "minItems": 1}}
    },
    "benign": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "scan_as"],
      "properties": {
        "path": {"type": "string"},
        "scan_as": {"type": "string"},
        "note": {"type": "string"}
      }
    },
    "mitre_atlas": {"type": "array", "items": {"type": "string"}},
    "owasp_asi": {"type": "array", "items": {"type": "string"}},
    "references": {"type": "array", "items": {"type": "string"}},
    "why_it_works": {"type": "string", "minLength": 10},
    "mitigations": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "false_positives": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}}
  }
}
